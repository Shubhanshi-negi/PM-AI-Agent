PORT=5000
PM_AI_DATA_DIR=

# Configure at least one provider. Groq is attempted before OpenAI.
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# Optional Slack integration. Without a token and channel, Inbox uses its documented Demo Mode.
SLACK_BOT_TOKEN=
SLACK_INBOX_CHANNEL=
SLACK_SIGNING_SECRET=